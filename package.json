  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "download:gtfs": "tsx scripts/download-gtfs.ts",
    "import:gtfs": "tsx scripts/import-gtfs.ts",
